{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zanezhang-67.github.io/absurd-video-museum/schema/video-catalog.schema.json",
  "title": "赛博抽象标本馆目录",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "videos"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "videos": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/video" }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "published_at",
        "added_at",
        "language",
        "tags",
        "media",
        "provenance",
        "rights",
        "moments",
        "absurdity",
        "lineage"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "published_at": { "type": "string", "format": "date" },
        "added_at": { "type": "string", "format": "date" },
        "language": { "$ref": "#/$defs/nonEmptyString" },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "src", "poster", "duration_seconds"],
          "properties": {
            "type": { "enum": ["local", "external"] },
            "src": { "$ref": "#/$defs/nonEmptyString" },
            "poster": { "$ref": "#/$defs/nonEmptyString" },
            "duration_seconds": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["creator", "original_url", "submitted_by", "source_note"],
          "properties": {
            "creator": { "$ref": "#/$defs/nonEmptyString" },
            "original_url": {
              "oneOf": [
                { "type": "string", "format": "uri" },
                { "type": "null" }
              ]
            },
            "submitted_by": { "$ref": "#/$defs/nonEmptyString" },
            "source_note": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["license", "owner", "evidence"],
          "properties": {
            "license": { "$ref": "#/$defs/nonEmptyString" },
            "owner": { "$ref": "#/$defs/nonEmptyString" },
            "evidence": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "moments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at", "label"],
            "properties": {
              "at": { "type": "number", "minimum": 0 },
              "label": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        },
        "absurdity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["logic_gap", "performance", "remixability", "context_collapse"],
          "properties": {
            "logic_gap": { "$ref": "#/$defs/score" },
            "performance": { "$ref": "#/$defs/score" },
            "remixability": { "$ref": "#/$defs/score" },
            "context_collapse": { "$ref": "#/$defs/score" }
          }
        },
        "lineage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["parents", "children"],
          "properties": {
            "parents": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            },
            "children": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            }
          }
        }
      }
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    }
  }
}
